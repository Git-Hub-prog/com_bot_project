NODE_ENV=development
PORT=5000

MONGO_URI=
# Optional deployment alias; use MONGO_URI or ATLASDB_URL, not both.
ATLASDB_URL=
MONGO_DB_NAME=testimonialhub

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

UPLOAD_MAX_SIZE_MB=5

EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
